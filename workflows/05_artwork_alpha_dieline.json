{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "labels/LB-2026-014/print_art_v1.png"
    },
    "_meta": {
      "title": "ВХОД: арт на чистом белом фоне (выход кейса 01/02)"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "width": 898,
      "height": 1488,
      "crop": "center"
    },
    "_meta": {
      "title": "898x1488 px = 76x126 мм @300 dpi (70x120 мм + вылет 3 мм)"
    }
  },
  "3": {
    "class_type": "ImageColorToMask",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "color": 16777215
    },
    "_meta": {
      "title": "Маска фона по цвету: 16777215 = #FFFFFF"
    }
  },
  "4": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Маска самой этикетки (контур вырубки)"
    }
  },
  "5": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "4",
        0
      ],
      "expand": 2,
      "tapered_corners": false
    },
    "_meta": {
      "title": "Компенсация антиалиасинга: +2 px по контуру (это НЕ вылет)"
    }
  },
  "6": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Маска прозрачности для JoinImageWithAlpha (1 = прозрачно)"
    }
  },
  "7": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "alpha": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "PNG-24 с альфой по контуру вырубки"
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "filename_prefix": "labels/LB-2026-014/print_art_alpha"
    },
    "_meta": {
      "title": "OUTPUT 1: печатный слой с альфой"
    }
  },
  "9": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Маска контура -> картинка"
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "labels/LB-2026-014/dieline_mask"
    },
    "_meta": {
      "title": "OUTPUT 2: отдельный слой вырубки для типографии"
    }
  },
  "11": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "Превью: прозрачность по контуру видна"
    }
  }
}
